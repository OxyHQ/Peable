# Read by server.ts (Bun loads .env). Never exposed to the page.
# A TEST-environment Oxy application credential (payments:read + payments:write).
PEABLE_PUBLIC_KEY=oxy_dk_your_public_key
PEABLE_SECRET=your_credential_secret

# The whsec_… that `peable listen` prints, or your webhook endpoint's secret.
PEABLE_WEBHOOK_SECRET=whsec_from_peable_listen

# Optional.
# PORT=4242
# PEABLE_API_URL=https://api.peable.to

# Read by Vite and bundled into the page — only public values here.
# VITE_PEABLE_API_URL=https://api.peable.to
