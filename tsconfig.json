{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  // Pure solution file: it orchestrates the per-package project references and
  // compiles nothing itself. `files: []` suppresses the default `**/*` include
  // so the root never double-includes package sources (which made `tsc -b`
  // expect in-place .d.ts outputs the noEmit frontend never emits → TS6305).
  //
  // `packages/shared-types` is deliberately NOT referenced here: it is a
  // publish-ready dual CJS/ESM package now (mirrors `@oxy.so/contracts`), built
  // with 3 non-composite tsconfigs (cjs/esm/types) rather than a single
  // composite project — consumers resolve it via node_modules like any other
  // published dependency, the same way oxy-api resolves `@oxy.so/contracts`.
  "files": [],
  "references": [
    { "path": "./packages/backend" },
    { "path": "./packages/frontend" }
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.expo"
  ]
}
