{
  "openapi": "3.1.0",
  "info": {
    "title": "Peable organization contributions",
    "version": "0.1.0",
    "description": "One-off links. Human Oxy session for management; existing /v1/payment_links/{id}/public and /payment_intent remain anonymous. Fixed/free amounts use FAIR base units (8 decimals); the registered merchant determines the network. Refunds cannot be created by the watch-only gateway. No recurring billing."
  },
  "servers": [
    {
      "url": "https://api.peable.to"
    }
  ],
  "components": {
    "securitySchemes": {
      "oxySession": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/organizations/{organizationId}/applications/{applicationId}/contributions": {
      "post": {
        "operationId": "createContribution",
        "security": [
          {
            "oxySession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "organizationId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "applicationId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "environment",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["development", "staging", "production"]
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "amountMode": {
                    "type": "string",
                    "enum": ["fixed", "free"]
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,15}$"
                  },
                  "currency": {
                    "type": "string",
                    "const": "FAIR"
                  },
                  "expiresAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["purpose", "amountMode", "currency"],
                "additionalProperties": false
              }
            }
          }
        },
