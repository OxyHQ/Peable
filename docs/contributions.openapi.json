{
  "openapi": "3.1.0",
  "info": {
    "title": "Peable organization contributions",
    "version": "0.2.0",
    "description": "One-off links. Human Oxy session for management; existing /v1/payment_links/{id}/public and /payment_intent remain anonymous. Fixed/free amounts use FAIR base units (8 decimals); the registered merchant determines the network. Refunds cannot be created by the watch-only gateway. No recurring billing."
  },
  "servers": [
    {
      "url": "https://api.peable.to"
    }
  ],
  "components": {
    "securitySchemes": {
      "oxySession": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/organizations/{organizationId}/applications/{applicationId}/contributions": {
      "post": {
        "operationId": "createContribution",
        "security": [
          {
            "oxySession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "organizationId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "applicationId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "environment",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["development", "staging", "production"]
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "amount_mode": {
                    "type": "string",
                    "enum": ["fixed", "free"]
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,15}$"
                  },
                  "currency": {
                    "type": "string",
                    "const": "FAIR"
                  },
                  "expires_at": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["purpose", "amount_mode", "currency"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "headers": {
              "Request-Id": {
                "description": "Identifies this request to Peable support.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "object": {
                      "type": "string",
                      "const": "payment_link"
                    },
                    "amount": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string",
                      "const": "FAIR"
                    },
                    "network": {
                      "type": "string",
                      "enum": ["mainnet", "testnet"]
                    },
                    "active": {
                      "type": "boolean"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "contribution": {
                      "type": "object",
                      "properties": {
                        "organization_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "purpose": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "amount_mode": {
                          "type": "string",
                          "enum": ["fixed", "free"]
                        },
                        "expires_at": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["organization_id", "purpose", "amount_mode", "expires_at"],
                      "additionalProperties": false
                    },
                    "created": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "id",
                    "object",
                    "amount",
                    "currency",
                    "network",
                    "active",
                    "url",
                    "contribution",
                    "created"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Peable error envelope; HTTP status identifies failure",
            "headers": {
              "Request-Id": {
                "description": "Identifies this request to Peable support.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": ["type", "message", "request_id"],
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "param": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "request_id": {
                          "type": ["string", "null"]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
