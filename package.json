{
  "name": "peable",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Peable monorepo — backend, mobile/web app, and shared types.",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter @peable.to/frontend dev",
    "dev:backend": "bun run --filter @peable.to/backend dev",
    "build": "bun run --filter '*' build",
    "build:shared-types": "bun run --filter @peable.to/shared-types build",
    "build:frontend": "bun run --filter @peable.to/frontend build",
    "build:backend": "bun run --filter @peable.to/backend build",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "validate:no-mongo": "bun ./scripts/validate-no-mongo.mjs && bun ./scripts/test-validate-no-mongo.mjs",
    "validate:lockfile": "bun ./scripts/check-lockfile-sync.mjs",
    "test:validate-lockfile": "bun ./scripts/test-check-lockfile-sync.mjs",
    "clean": "bun run --filter '*' clean && rm -rf node_modules",
    "install:all": "bun install",
    "start:frontend": "bun run --filter @peable.to/frontend start",
    "start:backend": "bun run --filter @peable.to/backend start",
    "postinstall": "bun run build:shared-types"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "@oxyhq/core": "23.3.2",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1"
  },
  "dependencies": {
    "@oxyhq/core": "^23.3.2"
  }
}
