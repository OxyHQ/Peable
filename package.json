{
  "name": "peable",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Peable monorepo — backend, mobile/web app, and shared types.",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter @peable.to/frontend dev",
    "dev:backend": "bun run --filter @peable.to/backend dev",
    "dev:orbit": "bun run --filter @peable.to/orbit dev",
    "build": "bun run --filter '*' build",
    "build:shared-types": "bun run --filter @peable.to/shared-types build",
    "build:frontend": "bun run --filter @peable.to/frontend build",
    "build:backend": "bun run --filter @peable.to/backend build",
    "build:orbit": "bun run --filter @peable.to/orbit build",
    "test": "bun run --filter '*' test",
    "lint": "biome check . && bun run --filter @peable.to/frontend lint && bun run --filter @peable.to/orbit lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "validate:lockfile": "bun ./scripts/check-lockfile-sync.mjs",
    "test:validate-lockfile": "bun ./scripts/test-check-lockfile-sync.mjs",
    "clean": "bun run --filter '*' clean && rm -rf node_modules",
    "install:all": "bun install",
    "start:frontend": "bun run --filter @peable.to/frontend start",
    "start:backend": "bun run --filter @peable.to/backend start",
    "start:orbit": "bun run --filter @peable.to/orbit start",
    "postinstall": "bun run build:contracts && bun run build:shared-types && bun run build:sdk && bun run build:pay",
    "test:edge": "bun test scripts/edge-worker.test.ts",
    "test:browser-entries": "bun test scripts/browser-entries.test.ts",
    "build:pay": "bun run --filter @peable.to/pay build",
    "build:contracts": "bun run --filter @peable.to/contracts build",
    "build:sdk": "bun run --filter @peable.to/sdk build",
    "generate:openapi": "bun scripts/openapi.ts && bun scripts/api-docs.ts",
    "check:openapi": "bun scripts/openapi.ts --check",
    "generate:api-docs": "bun scripts/api-docs.ts",
    "check:api-docs": "bun scripts/api-docs.ts --check",
    "test:api-docs": "bun test scripts/api-docs",
    "generate:sdk-resources": "bun run --filter @peable.to/sdk generate",
    "check:sdk-resources": "bun run --filter @peable.to/sdk check:generated"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^20.0.0",
    "esbuild": "0.25.12",
    "github-slugger": "2.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "@oxy.so/contracts": "6.15.0",
    "@oxy.so/core": "7.39.0",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "@oxy.so/telemetry": "2.1.0",
    "react-native-css": "3.1.0-rc.0",
    "@oxy.so/protocol": "1.11.0",
    "@peable.to/sdk": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@oxy.so/bloom": "17.15.0"
  },
  "dependencies": {
    "@oxy.so/core": "7.39.0"
  }
}
