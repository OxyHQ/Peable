{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Required so this project is a valid target of the root solution file's
    // project references (`tsc -b`). Metro — not tsc — owns the bundle, so the
    // type-checker stays `noEmit` (inherited from expo/tsconfig.base): nothing
    // consumes the frontend's declarations, and emitting .js/.d.ts into the
    // source tree would break expo-router file routing + Metro resolution.
    // `baseUrl` intentionally omitted (TS 6 / expo-router); `paths` resolve
    // relative to this file.
    "composite": true,
    "types": ["bun-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./app/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "image-types.d.ts"
  ]
}
