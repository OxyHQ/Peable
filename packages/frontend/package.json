  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "electron": "electron electron/main.js",
    "build": "expo export --platform web && bun run build:edge",
    "electron:build": "bun run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "lint": "expo lint",
    "build:android": "eas build --platform android --profile preview",
    "build:android:local": "bunx expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "build:edge": "bun build worker/index.js --target=browser --format=esm --outfile=dist/_worker.js"
  },
