{
  "name": "@peable.to/sdk",
  "version": "6.2.0",
  "description": "Peable server SDK — resource methods generated from the API contracts (`@peable.to/contracts`), with automatic idempotency keys, retries, timeouts and typed errors; `@peable.to/sdk/checkout` is the anonymous payer-side browser client, `/checkout/ui` its optional Bloom sheet, `/display` read-only display rates.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "react-native": "./dist/esm/index.js",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./checkout": {
      "react-native": "./dist/esm/checkout.js",
      "import": {
        "types": "./dist/types/checkout.d.ts",
        "default": "./dist/esm/checkout.js"
      },
      "require": {
        "types": "./dist/types/checkout.d.ts",
        "default": "./dist/cjs/checkout.js"
      },
      "default": "./dist/esm/checkout.js"
    },
    "./package.json": "./package.json",
    "./display": {
      "react-native": "./dist/esm/display.js",
      "import": {
        "types": "./dist/types/display.d.ts",
        "default": "./dist/esm/display.js"
      }
    },
    "./checkout/ui": {
      "react-native": {
        "types": "./dist/types/ui/index.d.ts",
        "default": "./dist/esm/ui/index.js"
      },
      "import": {
        "types": "./dist/types/ui/index.d.ts",
        "default": "./dist/esm/ui/index.js"
      },
      "default": "./dist/esm/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "peable",
    "oxy",
    "payments",
    "sdk",
    "faircoin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OxyHQ/Peable.git",
    "directory": "packages/sdk"
  },
  "author": "Peable",
  "license": "MIT",
  "homepage": "https://peable.to",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun run build:cjs && bun run build:esm && bun run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.mjs && node scripts/copy-ui-assets.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postbuild": "node scripts/verify-checkout-ui-package.mjs",
    "generate": "bun scripts/generate-resources.ts",
    "check:generated": "bun scripts/generate-resources.ts --check"
  },
  "dependencies": {
    "@peable.to/shared-types": "workspace:6.1.0",
    "qrcode-generator": "^2.0.4",
    "socket.io-client": "^4.8.3",
    "@peable.to/contracts": "workspace:6.1.0"
  },
  "devDependencies": {
    "@fairco.in/core": "0.5.0",
    "typescript": "~5.9.2",
    "@types/node": "^20.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "zod": "^4.6.7",
    "happy-dom": "^20.14.0",
    "react-dom": "19.3.0",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "@oxy.so/bloom": ">=16.10.0",
    "react": ">=19.0.0 <20.0.0",
    "react-native": ">=0.86.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@oxy.so/bloom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
