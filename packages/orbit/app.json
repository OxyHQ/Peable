{
  "expo": {
    "slug": "peable-orbit",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "peable-orbit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["oxycommons"]
      },
      "entitlements": {
        "keychain-access-groups": ["$(AppIdentifierPrefix)group.so.oxy.shared"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Orbit by Peable",
      "shortName": "Orbit"
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": false } }],
      "expo-secure-store",
      "@oxy.so/services/plugins/withOxySharedPermissions",
      "expo-font",
      "expo-system-ui",
      "expo-web-browser"
    ]
  }
}
