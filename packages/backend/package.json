{
  "name": "@peable.to/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fairco.in/core": "0.5.0",
    "@oxyhq/core": "^23.3.2",
    "@oxyhq/db": "0.1.2",
    "@peable.to/shared-types": "*",
    "@scure/bip32": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.1",
    "stripe": "22.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@oxyhq/contracts": "^0.17.0",
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.31.10",
    "socket.io-client": "^4.8.3",
    "typescript": "~5.9.2"
  }
}
