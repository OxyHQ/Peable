# Peable Gateway backend.
#
# Every key below is read by `src/config.ts` (or, where noted, by
# `@oxy.so/core`). Nothing else in this file is consulted at runtime — if you
# add a variable here, add its reader too, or it is a lie.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL. `config.ts` refuses to load without it, so the service cannot
# boot — and even tests that never touch the database need it set. Empty or
# whitespace counts as absent.
# Local server: `docker compose -f docker-compose.postgres.yml up -d`.
DATABASE_URL=postgres://peable:peable@localhost:5439/peable

# ---------------------------------------------------------------------------
# Effectively required in production
# ---------------------------------------------------------------------------

# Exact browser origins allowed through CORS and Socket.IO, comma-separated.
# Needed because `createOxyCors`'s built-in allowlist trusts only one-label
# `*.oxy.so` hosts: a two-label host such as `business.peable.to` must be listed
# here or it cannot reach the API at all.
# peable.to, checkout.peable.to and orbit.peable.to are built in (`config.ts`);
# Orbit's dev server is localhost:8082.
PEABLE_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,https://peable.to,https://checkout.peable.to,https://orbit.peable.to

# ---------------------------------------------------------------------------
# Optional — production defaults shown
# ---------------------------------------------------------------------------

PORT=3001
NODE_ENV=development

# `mainnet` or `testnet`; any other value throws at load.
PEABLE_NETWORK=mainnet

# FairCoin Explorer HTTP API. There is NO FairCoin RPC client in this repo and
# no RPC node dependency — chain reads go through the Explorer only.
# Defaults to `EXPLORER_BASE_URL` from `@fairco.in/core`.
EXPLORER_BASE_URL=https://explorer.fairco.in

# Base URL used to build `PaymentLink.url` and `CheckoutSession.url`.
PEABLE_CHECKOUT_BASE_URL=https://checkout.peable.to

# Oxy identity API: service-token mint, user JWT verification, and the
# application lookup the dashboard's RBAC delegates to.
OXY_API_URL=https://api.oxy.so

# ---------------------------------------------------------------------------
# Stripe — test and live side by side (ADR 0017)
# ---------------------------------------------------------------------------

# Each mode is optional and independent. A `production` merchant's money moves
# through the LIVE key, every other environment's through the TEST key; a mode
# with no key answers 503 on the card rail. The gateway refuses to boot if a
# key's prefix contradicts its variable (sk_/rk_live_ in a _TEST variable,
# pk_test_ in a _LIVE one). There is no single-mode STRIPE_SECRET_KEY.
#
# The card rail needs STRIPE_ENABLED=true AND, per mode, the secret key and
# both endpoint secrets. Tax and recurring billing need only the key.
# STRIPE_ENABLED=true

# STRIPE_SECRET_KEY_TEST=rk_test_...
# STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
# Endpoint secrets of the TEST-mode endpoints at /v1/webhooks/stripe and
# /v1/webhooks/stripe/connect (the same paths serve both modes).
# STRIPE_WEBHOOK_SECRET_TEST=whsec_...
# STRIPE_CONNECT_WEBHOOK_SECRET_TEST=whsec_...
# Rotation window: the outgoing secret, accepted beside the new one until removed.
# STRIPE_WEBHOOK_SECRET_PREVIOUS_TEST=
# STRIPE_CONNECT_WEBHOOK_SECRET_PREVIOUS_TEST=

# STRIPE_SECRET_KEY_LIVE=rk_live_...
# STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
# STRIPE_WEBHOOK_SECRET_LIVE=whsec_...
# STRIPE_CONNECT_WEBHOOK_SECRET_LIVE=whsec_...
# STRIPE_WEBHOOK_SECRET_PREVIOUS_LIVE=
# STRIPE_CONNECT_WEBHOOK_SECRET_PREVIOUS_LIVE=

# ---------------------------------------------------------------------------
# Read by @oxy.so/core, not by config.ts
# ---------------------------------------------------------------------------

# Salts for request hashing. Provisioned through SSM in production.
IP_HASH_SALT=
DEVICE_ID_SALT=

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------

# The server each test FILE creates its own throwaway, fully-migrated database
# on. NOT what the suites connect to — see AGENTS.md.
# TEST_DATABASE_URL=postgres://peable:peable@localhost:5439/postgres

# Publish aggregate service traffic and infrastructure to the Oxy dashboard.
# Starts automatically once both credential vars below are set — there is no
# separate enable flag.
AWS_REGION=us-west-2
OXY_SERVICE_API_KEY=
OXY_SERVICE_API_SECRET=
