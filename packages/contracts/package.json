{
  "name": "@peable.to/contracts",
  "version": "6.1.0",
  "description": "The Peable wire, declared once: Zod contracts of every public route, the OpenAPI 3.1 generator and the closed value sets (ADR 0014 D5).",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "react-native": "./dist/esm/index.js",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./vocabulary": {
      "react-native": "./dist/esm/vocabulary/index.js",
      "import": {
        "types": "./dist/types/vocabulary/index.d.ts",
        "default": "./dist/esm/vocabulary/index.js"
      },
      "require": {
        "types": "./dist/types/vocabulary/index.d.ts",
        "default": "./dist/cjs/vocabulary/index.js"
      },
      "default": "./dist/esm/vocabulary/index.js"
    },
    "./vocabulary/*": {
      "react-native": "./dist/esm/vocabulary/*.js",
      "import": {
        "types": "./dist/types/vocabulary/*.d.ts",
        "default": "./dist/esm/vocabulary/*.js"
      },
      "require": {
        "types": "./dist/types/vocabulary/*.d.ts",
        "default": "./dist/cjs/vocabulary/*.js"
      },
      "default": "./dist/esm/vocabulary/*.js"
    },
    "./contributions": {
      "react-native": "./dist/esm/contributions.js",
      "import": {
        "types": "./dist/types/contributions.d.ts",
        "default": "./dist/esm/contributions.js"
      },
      "require": {
        "types": "./dist/types/contributions.d.ts",
        "default": "./dist/cjs/contributions.js"
      },
      "default": "./dist/esm/contributions.js"
    },
    "./openapi": {
      "react-native": "./dist/esm/openapi/index.js",
      "import": {
        "types": "./dist/types/openapi/index.d.ts",
        "default": "./dist/esm/openapi/index.js"
      },
      "require": {
        "types": "./dist/types/openapi/index.d.ts",
        "default": "./dist/cjs/openapi/index.js"
      },
      "default": "./dist/esm/openapi/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "peable",
    "payments",
    "openapi",
    "zod",
    "contracts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OxyHQ/Peable.git",
    "directory": "packages/contracts"
  },
  "author": "Peable",
  "license": "MIT",
  "homepage": "https://peable.to",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun run build:cjs && bun run build:esm && bun run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/node": "^20.0.0",
    "@types/bun": "latest"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "typesVersions": {
    "*": {
      "vocabulary": [
        "./dist/types/vocabulary/index.d.ts"
      ],
      "vocabulary/*": [
        "./dist/types/vocabulary/*.d.ts"
      ],
      "contributions": [
        "./dist/types/contributions.d.ts"
      ],
      "openapi": [
        "./dist/types/openapi/index.d.ts"
      ]
    }
  }
}
